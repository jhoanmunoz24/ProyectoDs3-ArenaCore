# Puertos expuestos en el host (puedes cambiarlos en tu .env local si algún puerto ya está ocupado)
DB_IDENTITY_PORT=55431
DB_COURTS_PORT=55432
DB_EQUIPMENT_PORT=55433
DB_BILLING_PORT=55434

IDENTITY_PORT=8081
COURTS_PORT=8080
EQUIPMENT_PORT=8082
BILLING_PORT=8083

# Credenciales maestras PostgreSQL (solo inicialización de contenedores)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=arenacore_pg_root

# Credenciales separadas App vs Migración Flyway (RNF-02)
IDENTITY_MIGRATOR_USER=identity_migrator
IDENTITY_MIGRATOR_PASSWORD=identity_mig_pass
IDENTITY_APP_USER=identity_app
IDENTITY_APP_PASSWORD=identity_app_pass

COURTS_MIGRATOR_USER=courts_migrator
COURTS_MIGRATOR_PASSWORD=courts_mig_pass
COURTS_APP_USER=courts_app
COURTS_APP_PASSWORD=courts_app_pass

EQUIPMENT_MIGRATOR_USER=equipment_migrator
EQUIPMENT_MIGRATOR_PASSWORD=equipment_mig_pass
EQUIPMENT_APP_USER=equipment_app
EQUIPMENT_APP_PASSWORD=equipment_app_pass

BILLING_MIGRATOR_USER=billing_migrator
BILLING_MIGRATOR_PASSWORD=billing_mig_pass
BILLING_APP_USER=billing_app
BILLING_APP_PASSWORD=billing_app_pass

# Bootstrap de Superadministrador (Identity Service)
BOOTSTRAP_ADMIN_EMAIL=admin@arenacore.local
BOOTSTRAP_ADMIN_PASSWORD=Admin1234!
BOOTSTRAP_OPERATOR_EMAIL=operador@arenacore.local
BOOTSTRAP_OPERATOR_PASSWORD=Operador1234!

# Credenciales técnicas SERVICE_INTERNAL para comunicación entre microservicios (HT-07)
INTERNAL_CLIENT_COURTS_SECRET=courts-internal-secret-2026
INTERNAL_CLIENT_EQUIPMENT_SECRET=equipment-internal-secret-2026
INTERNAL_CLIENT_BILLING_SECRET=billing-internal-secret-2026

# CORS Frontend React + Vite
CORS_ALLOWED_ORIGINS=http://localhost:5173
